# Copy this file to .env for local development. Never commit the real .env.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_SILK=False

# Use dental_clinic.settings_production in AWS.
DJANGO_SETTINGS_MODULE=dental_clinic.settings
CSRF_TRUSTED_ORIGINS=

# Enable only after HTTPS is configured on the AWS load balancer.
DJANGO_HTTPS_ENABLED=False
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# PostgreSQL used by docker-compose.yml
DB_NAME=dental_clinic
DB_USER=dental_clinic
DB_PASSWORD=change-me-for-local-development
DB_HOST=db
DB_PORT=5432

# Production PostgreSQL connections require encryption.
DB_SSLMODE=require
# Optional alternative used by hosting platforms such as Render. When set,
# DATABASE_URL takes precedence over the separate DB_* variables above.
DATABASE_URL=

# Optional Cloudinary storage. Leave blank when using local media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
XRAY_CLOUD_UPLOAD_ENABLED=False
XRAY_MAX_UPLOAD_SIZE_MB=10
XRAY_MAX_IMAGE_PIXELS=25000000

# Application server
PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
